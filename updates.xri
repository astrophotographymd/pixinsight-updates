<xri version="1.0">

   <description>
      <p>
         Astrophotography MD LLC update repository. This repository distributes
         AstroMD Social Export, a PixInsight script for social media exports.
      </p>
   </description>

   <platform os="all" arch="noarch" version="1.8.9:1.9.99">
      <package fileName="20261117-AstroMD-SocialExport-1.5.1.tar.gz"
